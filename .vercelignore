# Ignorar carpetas extremadamente pesadas para evitar el límite de subida de Vercel (10MB)
/videos/
TEAM AM/
Carillas dentales/
portafolio-diseno-de-sonrisa-am-estetica-dental/

# NO agregar aquí ninguna carpeta que sea Root Directory de un proyecto de
# Vercel (amesteticadental, amesteticadental-uy, arielmerino, thedentalreview).
# Este archivo se aplica desde la raíz del repo a los CUATRO builds: si se
# ignora la carpeta, Vercel borra el package.json antes de compilar y el build
# muere con "No Next.js version detected". Aquí solo van assets pesados.

# Ignorar dependencias y compilados locales (se compilan en los servidores de Vercel)
node_modules/
.next/
amesteticadental/node_modules/
amesteticadental/.next/
amesteticadental-uy/node_modules/
amesteticadental-uy/.next/
arielmerino/node_modules/
arielmerino/.next/
thedentalreview/node_modules/
thedentalreview/.next/

# Ignorar archivos locales temporales y de configuración del agente
.claude/
.claude-flow/
.git/
scratch/
*.pdf
ADS KEYWORDS/
GBP/
Logos/
.DS_Store
